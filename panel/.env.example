# .env  —  chmod 600 .env

# Panel giris sifresi (tek admin)
ADMIN_PASSWORD=buraya-guclu-bir-sifre

# Cerez imzalama anahtari — degistir: openssl rand -hex 32
SESSION_SECRET=buraya-64-karakterlik-rastgele

# Postgres sifresi — degistir: openssl rand -hex 24
DB_PASS=buraya-rastgele-db-sifresi

# Tuya cihaz kimligi (bilgi amacli)
TUYA_DEVICE_ID=0123456789abcdef0123

# Istersen sabit device token; bos birakirsan ilk acilista uretilir ve log'a yazilir
DEVICE_TOKEN=

# HTTPS arkasinda oldugu icin 1 kalsin. Lokal HTTP testinde 0 yap.
COOKIE_SECURE=1
